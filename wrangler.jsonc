{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caten-church",
  // Not a secret; the account that also hosts danmu-classroom and the caten-church.org zone
  "account_id": "c74b247e8c747f6ca397cca820da6319",
  "main": "src/index.ts",
  // Served only on our own domain, never on the account's shared workers.dev subdomain
  "workers_dev": false,
  "preview_urls": false,
  // Preview while caten-church.org still points at the Rails site; add the apex at cut-over
  "routes": [{ "pattern": "beta.caten-church.org", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Static files (logo, favicon, stylesheet); every other path goes to the Worker
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caten-church",
      "database_id": "fc5c6b22-7ba8-4bcd-8bd1-46bf263d4116",
      "migrations_dir": "migrations",
    },
  ],
  // Weekly PDFs (weeklies/<id>.pdf) and admin-uploaded site images (site/...)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "caten-church" }],
  // Public address used in links inside emails
  "vars": { "SITE_URL": "https://caten-church.org" },
  // 03:00 UTC on the 25th = 11:00 in Taipei: next month's birthdays go to the admins
  "triggers": { "crons": ["0 3 25 * *"] },
}
