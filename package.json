{
  "name": "caten-church",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "predev": "wrangler d1 migrations apply DB --local",
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc -p .",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
