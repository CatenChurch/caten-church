{
  "name": "caten-church",
  "version": "1.0.0",
  "private": true,
  "author": "楊竑昕 <jk195417@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=iife --target=es2020 --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import",
    "lint": "eslint app/javascript",
    "format": "prettier --write 'app/javascript/**/*.js'"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@hotwired/turbo-rails": "^8.0.12",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "esbuild": "^0.25.0",
    "flatpickr": "^4.6.13",
    "sass": "^1.89.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0"
  },
  "engines": {
    "node": "24.x"
  }
}
