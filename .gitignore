# Ignore bundler config.
/.bundle/*
!/.bundle/config

# Log and temp files.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
.byebug_history

# Active Storage blobs
/storage/*
!/storage/.keep

# Credentials
/config/master.key
/config/credentials/*.key
*.pem

# Assets built by jsbundling/cssbundling and precompiled by Propshaft
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Node
/node_modules

# Environment
.env

# Mac OS X system file
.DS_Store
