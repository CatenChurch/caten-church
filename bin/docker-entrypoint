#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Optionally prepare the database before starting the web server.
# Kubernetes deployments run migrations in a separate Job instead (see charts/caten-church).
if [ "${DB_PREPARE}" == "true" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
