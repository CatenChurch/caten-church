<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Assets (cssbundling + jsbundling, served by Propshaft) -->
<%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
<%= javascript_include_tag 'application', 'data-turbo-track': 'reload', defer: true %>
<%= favicon_link_tag 'favicon.png', type: 'image/png' %>
<!-- SEO -->
<meta property="og:type" content="website">
<%= display_meta_tags site: '茄典教會' %>
<% if Rails.env.production? %>
  <% track_id = ENV['GA_TRACK_ID'] || Rails.application.credentials.dig(:ga, :track_id) %>
  <% if track_id.present? %>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= track_id %>"></script>
    <script type="text/javascript">
      document.addEventListener('turbo:load', () => {
        window.dataLayer = window.dataLayer || []
        function gtag() {
          // eslint-disable-next-line prefer-rest-params
          window.dataLayer.push(arguments)
        }
        gtag('js', new Date())
        gtag('config', '<%= track_id %>')
      })
    </script>
  <% end %>
<% end %>
<!-- CSRF -->
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
